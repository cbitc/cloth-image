# ---- 后端 ----
# 数据库：本地 SQLite（零外部依赖，开箱即用）
DATABASE_URL=sqlite:///./.data/app.db

# 任务执行方式：inline（进程内线程池，默认）| sync（同步，测试用）
TASK_EXECUTION=inline

# 图片存储：本地目录 + /media 路由对外提供
# 默认 backend/.data/objects，一般无需修改
# LOCAL_STORAGE_DIR=
PUBLIC_BASE_URL=http://localhost:8000
MEDIA_URL_PREFIX=/media

# ------------------------------------------------------------------ #
# 能力配置（provider / 端点 / Key / 模型）
# ------------------------------------------------------------------ #
# 能力的 provider、base_url、api_key、model **只在设置页配置**（写入数据库、立即生效）：
#     http://localhost:3000/settings
# 环境变量不再参与能力配置（这是刻意的：消除隐式回退与多层兼容）。
#
# 能力与可选实现：
#   clothing_search     : unsplash                 （Unsplash 图库检索，只需 Access Key）
#   material_search     : unsplash                 （Unsplash 面料特写，同一 Access Key）
#   material_identifier : openai_compatible        （OpenAI 兼容 /chat/completions）
#   design_generator    : openai_compatible_image  （OpenAI 兼容 /images/generations）
# 未选择实现的能力不可用 → 请在设置页逐项选择并填写端点 / Key / 模型。

# ------------------------------------------------------------------ #
# 生图参数（环境变量打底，设置页可覆盖）
# ------------------------------------------------------------------ #
# 注意：必须用 x 分隔（写成 1024*1024 会被 API 拒绝）
IMAGE_SIZE=1024x1024
# 单次生图最多传几张参考图（原服装图 + 材质图之和）
# 实测 qwen-image-3.0 限制：0 张 = 文生图，1~3 张 = 图生图（超过 3 会直接 400）
IMAGE_MAX_REFS=3
# 是否让模型改写我们的提示词（我们已结构化组装，默认关闭）
PROMPT_EXTEND=false

# ------------------------------------------------------------------ #
# HTTP / 图片
# ------------------------------------------------------------------ #
PROVIDER_TIMEOUT_S=90
PROVIDER_MAX_RETRIES=3
VISION_MAX_IMAGE_SIDE=1568
DOWNLOAD_MAX_BYTES=15000000

# 相同图片 + 相同模型时复用识别结果（省一次 VLM 调用）
IDENTIFY_CACHE_ENABLED=true

# ------------------------------------------------------------------ #
# 登录 / 许可（entitlement-api-new）
# ------------------------------------------------------------------ #
# 只实现「邮箱验证码登录 + 查询有效许可」，**不拦截任何业务接口**。
# 登录后许可证写在 httpOnly cookie 里，前端通过 GET /api/auth/me 查询。
ENTITLEMENT_API_BASE_URL=http://localhost:3001
# 必须与 entitlement-api-new 的 LICENSE_JWT_SECRET 完全一致（只用于本地验签）
ENTITLEMENT_LICENSE_JWT_SECRET=
ENTITLEMENT_PRODUCT_CODE=cloth-image
ENTITLEMENT_EDITION_CODE=pro
# 整站共用一个激活槽（Web 端没有可信设备指纹）
ENTITLEMENT_MACHINE_ID=cloth-image-server
ENTITLEMENT_LICENSE_ISSUER=entitlement-api
ENTITLEMENT_LICENSE_AUDIENCE=entitlement-client
AUTH_COOKIE_NAME=ci_license
# 生产环境走 HTTPS 时必须设为 true
AUTH_COOKIE_SECURE=false

# 带 cookie 的跨端口请求不能用 "*"；多个来源用逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
