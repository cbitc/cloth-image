# ---- 后端 ----
# 数据库：默认 SQLite（本机零依赖直跑）；docker compose 内由 compose 覆盖为 Postgres
DATABASE_URL=sqlite:///./.data/app.db
# 想本机连 Postgres 时用：
# DATABASE_URL=postgresql+psycopg://cloth:cloth@localhost:5432/cloth
# 任务队列
REDIS_URL=redis://localhost:6379/0
# 任务执行方式：inline（进程内后台任务，便于本地/测试）| celery（需 worker）
TASK_EXECUTION=inline

# 对象存储：local（写本地目录，无需 MinIO）| s3（MinIO / S3 兼容）
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cloth-images

# ------------------------------------------------------------------ #
# 能力提供方（按能力独立选择；留空则回退到 PROVIDER_MODE）
# ------------------------------------------------------------------ #
# 全局兜底：mock（假数据，零外部依赖）| real（全部走真实实现）
PROVIDER_MODE=mock

# clothing_search     : mock | serpapi（serpapi 仍是空壳）
# material_identifier : mock | maas
# material_search     : mock | serpapi（serpapi 仍是空壳）
# design_generator    : mock | dashscope | fal（fal 仍是空壳）
#
# 典型用法：只把“识别”与“生图”切到真实模型，搜图仍然用 mock：
#   MATERIAL_IDENTIFIER_PROVIDER=maas
#   DESIGN_GENERATOR_PROVIDER=dashscope
CLOTHING_SEARCH_PROVIDER=
MATERIAL_IDENTIFIER_PROVIDER=maas
MATERIAL_SEARCH_PROVIDER=
DESIGN_GENERATOR_PROVIDER=

# ------------------------------------------------------------------ #
# 阿里云 MaaS（OpenAI 兼容）—— 视觉理解与生图共用同一端点
# ------------------------------------------------------------------ #
MAAS_BASE_URL=https://ws-yilqbuvsxvumn3ms.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MAAS_API_KEY=sk-ws-H.PPRMHMM.Ch5H.MEYCIQDKmyIiElzA_oZgUQwEb4aK5t06rJY-jNRaZ2BLq2X9rgIhALlOKLg9Ueh8tUlNUGSwC58oLKkMJwolhSNAW9WfIOuW
# 视觉语言模型（材质识别）
VLM_MODEL=qwen3-vl-plus
# 生图模型
IMAGE_MODEL=qwen-image-3.0
# 注意：必须用 x 分隔（写成 1024*1024 会被 API 拒绝）
IMAGE_SIZE=1024x1024
# 单次生图最多传几张参考图（原服装图 + 材质图之和）
# 实测 qwen-image-3.0 限制：0 张 = 文生图，1~3 张 = 图生图（超过 3 会直接 400）
IMAGE_MAX_REFS=3
# 是否让模型改写我们的提示词（我们已结构化组装，默认关闭）
PROMPT_EXTEND=false

# 可选：分别覆盖上面两项（留空则回退到 MAAS_*），便于将来换厂商
VLM_BASE_URL=
VLM_API_KEY=
IMAGE_BASE_URL=
IMAGE_API_KEY=

# ------------------------------------------------------------------ #
# 其他真实 provider 的 Key
# ------------------------------------------------------------------ #
SERPAPI_API_KEY=
FAL_KEY=

# ------------------------------------------------------------------ #
# HTTP / 图片
# ------------------------------------------------------------------ #
PROVIDER_TIMEOUT_S=90
PROVIDER_MAX_RETRIES=3
VISION_MAX_IMAGE_SIDE=1568
DOWNLOAD_MAX_BYTES=15000000

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
